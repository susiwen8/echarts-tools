{
  "name": "echarts-cli",
  "version": "0.1.0",
  "description": "Offline knowledge CLI for Apache ECharts users",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "echarts": "dist/rust/echarts"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "development.md"
  ],
  "scripts": {
    "cli": "./target/debug/echarts",
    "build:data": "npm run rust:build:data",
    "prepack": "npm run rust:dist:prepare && npm run rust:build:data",
    "start": "./target/debug/echarts",
    "test": "node scripts/test-all.js",
    "test:compat": "node --test __tests__/compat.test.js",
    "test:parity": "node --test __tests__/parity-harness.test.js",
    "test:parity:rust": "ECHARTS_CLI_RUN_RUST_PARITY=1 node --test __tests__/parity-harness.test.js",
    "rust:build": "node scripts/rust-tools.js cargo build --quiet --bin echarts",
    "rust:run": "node scripts/rust-tools.js cargo run --quiet --bin echarts --",
    "bench:compare": "node scripts/benchmark-rust-vs-js.js",
    "rust:build:data": "node scripts/rust-tools.js cargo run --quiet --bin echarts-build-data --",
    "cli:js": "node bin/echarts.js",
    "rust:build:release": "node scripts/rust-tools.js cargo build --release --quiet --bin echarts --bin echarts-build-data",
    "rust:dist:prepare": "node scripts/prepare-rust-dist.js",
    "rust:dist:verify": "node scripts/verify-packed-rust-dist.js",
    "cli:release": "./dist/rust/echarts",
    "npm:platform:prepare": "node scripts/prepare-platform-package.js",
    "npm:platform:prepare:all": "node scripts/prepare-platform-package.js all",
    "npm:platform:verify": "node scripts/verify-platform-package.js",
    "npm:platform:verify:all": "node scripts/verify-platform-package.js all",
    "npm:platform:publish": "node scripts/publish-platform-package.js",
    "npm:platform:publish:all": "node scripts/publish-platform-package.js all"
  },
  "dependencies": {
    "commander": "2.11.0"
  },
  "private": true
}
